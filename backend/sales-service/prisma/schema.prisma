generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Sale {
  id String @id @default(uuid()) @db.Uuid

  customerName String

  total Float

  createdAt DateTime @default(now())

  details SaleDetail[]

  @@map("sales")
}

model SaleDetail {
  id String @id @default(uuid()) @db.Uuid

  saleId String @db.Uuid

  productId String @db.Uuid

  quantity Int

  price Float

  sale Sale @relation(fields: [saleId], references: [id])

  @@map("sale_details")
}
